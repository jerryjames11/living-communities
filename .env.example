# Copy this file to .env for local development.
# Render/Railway/Neon dashboards inject these as real environment variables in production —
# you never commit a real .env file (it's gitignored).

# Local Postgres example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livingcommunities
# Neon/Supabase example (note ?sslmode=require — the app auto-detects this and enables SSL):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/livingcommunities?sslmode=require

PORT=3000
# Lock this down to your real domain before going live, e.g. https://livingcommunities.com
ALLOWED_ORIGIN=*

# --- Stripe billing (optional — leave unset to run in demo/simulated-billing mode) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin account bootstrap (optional) ---
# Set both to create the ONE admin login on next server start (idempotent — safe to leave set).
# There's no public "sign up as admin" page; this env pair is the only way in. Use a real email
# you control and a strong, unique password.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=change-me-to-something-strong

# --- Email (optional — leave unset and emails just log to the console instead of sending) ---
# Get a key at https://resend.com (free tier is plenty to start).
# RESEND_API_KEY=re_...
# Who emails appear to come from. Until you verify your own domain with Resend, every email can
# ONLY be delivered to the email address on your Resend account — everyone else's emails silently
# fail. Verify a domain at https://resend.com/domains, then use an address at that domain here.
# EMAIL_FROM=Living Communities <hello@yourdomain.com>
# Where admin alerts go (new signups, low ratings, payment failures, the daily digest, etc).
# Falls back to ADMIN_EMAIL above if unset, so you get these for free with zero extra config.
# ADMIN_NOTIFY_EMAIL=you@yourcompany.com

# --- Scheduled jobs (optional) ---
# Shared secret for an external cron/pinger (e.g. cron-job.org, Render Cron Jobs) to trigger:
#   POST /api/internal/run-billing-check   — Home Care Plan reminders + demo-mode charges
#   POST /api/internal/run-admin-digest    — the daily admin rollup email
# both with header:  x-internal-key: <this value>
# INTERNAL_JOB_KEY=some-long-random-string
