# Copy this file to .env for local development.
# Render/Railway/Neon dashboards inject these as real environment variables in production —
# you never commit a real .env file (it's gitignored).

# Local Postgres example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livingcommunities
# Neon/Supabase example (note ?sslmode=require — the app auto-detects this and enables SSL):
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/livingcommunities?sslmode=require

PORT=3000
# Lock this down to your real domain before going live, e.g. https://livingcommunities.com
ALLOWED_ORIGIN=*

# --- Stripe billing (optional — leave unset to run in demo/simulated-billing mode) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin account bootstrap (optional) ---
# Set both to create the ONE admin login on next server start (idempotent — safe to leave set).
# There's no public "sign up as admin" page; this env pair is the only way in. Use a real email
# you control and a strong, unique password.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=change-me-to-something-strong
